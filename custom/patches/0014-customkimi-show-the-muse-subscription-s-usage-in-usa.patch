+/**
+ * The `/usage` Muse panel: the subscription's two quotas as bars under a heading that
+ * carries the muse version, then the token counts and the request count.
+ */
+export function buildMuseUsageReportLines(options: MuseUsageReportLineOptions): string[] {
+  const accent = (text: string) => currentTheme.boldFg('primary', text);
+  const value = (text: string) => currentTheme.fg('text', text);
+  const muted = (text: string) => currentTheme.fg('textDim', text);
+  const errorStyle = (text: string) => currentTheme.fg('error', text);
+
+  const usage = options.museUsage;
+  const heading = usage?.version === undefined ? 'Muse usage' : `Muse usage · v${usage.version}`;
+  const lines = buildManagedUsageSection(
+    usage === undefined ? undefined : { rows: toQuotaRows(usage) },
+    options.museUsageError,
+    accent,
+    value,
+    muted,
+    errorStyle,
+    heading,
+  );
+  if (usage === undefined) return lines;
+
+  const { tokens } = usage;
+  const counts =
+    `in ${value(formatTokenCount(tokens.input))}  out ${value(formatTokenCount(tokens.output))}  ` +
+    `cached ${value(formatTokenCount(tokens.cached))}  reasoning ${value(formatTokenCount(tokens.reasoning))}`;
+  const requests =
+    usage.requests === undefined ? '' : `  ·  ${value(String(usage.requests))} ${muted('requests')}`;
+  lines.push(`  ${muted('tokens')}  ${counts}${requests}`);
+  return lines;
+}
