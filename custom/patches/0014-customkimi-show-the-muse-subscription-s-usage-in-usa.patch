+/** The parts of a provider's configuration the usage lookup reads. */
+export interface MuseProviderConfig {
+  readonly type?: string;
+  readonly baseUrl?: string;
+  readonly apiKeyEnv?: string;
+}
+
+/**
+ * The muse forwarder is a subscription, not a prepaid balance, so it is not a
+ * `BillingProvider`: both renderers of `ProviderBalance` format dollars. It is recognised by
+ * the key variable its provider entry names.
+ */
+export function isMuseProvider(provider: MuseProviderConfig | undefined): boolean {
+  return provider?.apiKeyEnv === MUSE_API_KEY_ENV;
+}
+
+/** The forwarder's usage endpoint: /usage lives at the root of the host, next to /v1. */
+export function museUsageUrl(baseUrl: string): string {
+  return `${new URL(baseUrl).origin}/usage`;
+}
+
+/**
+ * The forwarder's endpoint for `provider`, read at `baseUrl` (a model's own base URL, else
+ * the provider's), or undefined when the provider is not the muse forwarder, has no base
+ * URL, or its key is not set (blank counts as unset).
+ */
+export function museEndpoint(
+  provider: MuseProviderConfig | undefined,
+  baseUrl: string | undefined = provider?.baseUrl,
+  env: BillingEnv = process.env,
+): MuseEndpoint | undefined {
+  if (!isMuseProvider(provider)) return undefined;
+  const key = env[MUSE_API_KEY_ENV]?.trim();
+  return baseUrl === undefined || key === undefined || key === '' ? undefined : { baseUrl, key };
+}
+
+/** The endpoint of the muse provider among `providers`, whichever model is active. */
+export function configuredMuseEndpoint(
+  providers: Readonly<Record<string, MuseProviderConfig>>,
+  env: BillingEnv = process.env,
+): MuseEndpoint | undefined {
+  for (const provider of Object.values(providers)) {
+    const endpoint = museEndpoint(provider, provider.baseUrl, env);
+    if (endpoint !== undefined) return endpoint;
+  }
+  return undefined;
+}
+
+/** "5h window", "45m window" or "1h 30m window" from the window's length; "Window" without one. */
+export function windowLabel(minutes: number | undefined): string {
+  const whole = minutes === undefined || !Number.isFinite(minutes) ? 0 : Math.round(minutes);
+  if (whole <= 0) return 'Window';
+  const hours = Math.floor(whole / 60);
+  const rest = whole % 60;
+  if (hours === 0) return `${String(rest)}m window`;
+  return rest === 0 ? `${String(hours)}h window` : `${String(hours)}h ${String(rest)}m window`;
+}
+
+/**
+ * The usage from the forwarder's reply, or undefined unless both quotas carry a numeric
+ * `used_percent`. Percentages become 0..1 ratios; `resets_at` (UNIX seconds) becomes an ISO
+ * string, which is what the usage panel's reset hint parses.
+ */
+export function parseMuseUsage(json: unknown): MuseUsage | undefined {
+  const reply = asRecord(json);
+  const subscription = asRecord(reply?.['subscription']);
+  const weekly = parseWindow(subscription?.['weekly']);
+  const window = asRecord(subscription?.['window']);
+  const windowQuota = parseWindow(window);
+  if (weekly === undefined || windowQuota === undefined) return undefined;
+  const tokens = asRecord(reply?.['tokens']);
+  const version = asRecord(reply?.['identity'])?.['muse_version'];
+  return {
+    weekly,
+    window: windowQuota,
+    windowLabel: windowLabel(toFiniteNumber(window?.['window_duration_mins'])),
+    version: typeof version === 'string' && version !== '' ? version : undefined,
+    tokens: {
+      input: tokenCount(tokens?.['input']),
+      output: tokenCount(tokens?.['output']),
+      cached: tokenCount(tokens?.['cached']),
+      reasoning: tokenCount(tokens?.['reasoning']),
+    },
+    requests: toFiniteNumber(reply?.['requests']),
+  };
+}
+
+function parseWindow(value: unknown): MuseWindow | undefined {
+  const quota = asRecord(value);
+  const percent = toFiniteNumber(quota?.['used_percent']);
+  if (percent === undefined) return undefined;
+  return {
+    usedRatio: Math.max(0, Math.min(percent / 100, 1)),
+    resetAt: isoFromUnixSeconds(quota?.['resets_at']),
+  };
+}
+
+function isoFromUnixSeconds(value: unknown): string | undefined {
+  const seconds = toFiniteNumber(value);
+  if (seconds === undefined) return undefined;
+  const date = new Date(seconds * 1000);
+  return Number.isNaN(date.getTime()) ? undefined : date.toISOString();
+}
+
+function tokenCount(value: unknown): number {
+  const count = toFiniteNumber(value);
+  return count === undefined || count < 0 ? 0 : count;
+}
+
+/**
+ * GETs the forwarder's /usage with the key as a bearer token; resolves undefined without a
+ * key and on any failure, like `BillingProvider.getJson()`. Node's fetch honours
+ * NODE_EXTRA_CA_CERTS, so the forwarder's certificate needs no handling here.
+ */
+export async function fetchMuseUsage(
+  baseUrl: string,
+  key: string | undefined,
+  fetcher: Fetcher = globalThis.fetch,
+): Promise<MuseUsage | undefined> {
+  if (key === undefined) return undefined;
+  try {
+    const response = await fetcher(museUsageUrl(baseUrl), {
+      headers: { Authorization: `Bearer ${key}` },
+      signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+    });
+    return response.ok ? parseMuseUsage(await response.json()) : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+/** The two quotas as rows of the usage panel's bar renderer. */
+export function toQuotaRows(usage: MuseUsage): QuotaUsageRow[] {
+  return [
+    { name: 'Weekly', usedRatio: usage.weekly.usedRatio, resetAt: usage.weekly.resetAt },
+    { name: usage.windowLabel, usedRatio: usage.window.usedRatio, resetAt: usage.window.resetAt },
+  ];
+}
