+/**
+ * Adds `GET /api/customkimi/muse-usage?model=<alias>` (bearer auth like every /api route):
+ * the muse subscription's usage when the alias, or without one the default model, is served
+ * by the muse provider, else null. Replies are cached per alias for a minute, in-flight
+ * requests included, so the browser's refreshes do not all reach the forwarder.
+ */
+export function registerMuseUsageRoute(app: BadgeRouteHost, options: MuseUsageRouteOptions = {}): void {
+  const loadConfig = options.loadConfig ?? loadBadgeConfig;
+  const fetchUsage = options.fetchUsage ?? fetchMuseUsage;
+  const env = options.env ?? process.env;
+  const now = options.now ?? Date.now;
+  const cache = new Map<string, CachedMuseUsage>();
+
+  const usageFor = (config: BadgeConfig, alias: string): Promise<MuseUsage | undefined> => {
+    const model = config.models[alias];
+    const endpoint =
+      model === undefined ? undefined : museEndpoint(config.providers[model.provider], model.baseUrl, env);
+    if (endpoint === undefined) return Promise.resolve(undefined);
+    const cached = cache.get(alias);
+    if (cached !== undefined && cached.expiresAt > now()) return cached.usage;
+    const usage = fetchUsage(endpoint.baseUrl, endpoint.key);
+    cache.set(alias, { expiresAt: now() + MUSE_USAGE_CACHE_MS, usage });
+    return usage;
+  };
+
+  app.get(MUSE_USAGE_API_PATH, async (req, reply) => {
+    const config = loadConfig();
+    const alias = requestedModel(req.query, config);
+    const usage = alias === undefined ? undefined : await usageFor(config, alias);
+    return reply
+      .type('application/json; charset=utf-8')
+      .send({ code: 0, msg: 'success', data: usage ?? null });
+  });
+}
