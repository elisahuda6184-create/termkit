@@ -0,0 +1,63 @@
+import { describe, expect, it, vi } from 'vitest';
+
+import { applyGeminiFilterRetryChoice } from '#/tui/commands/config';
+
+function makeHost(geminiFilterRetry: boolean | 'subagents' | undefined) {
+  return {
+    harness: {
+      getConfig: vi.fn(async () => ({ geminiFilterRetry })),
+      setConfig: vi.fn(async () => ({})),
+    },
+    showStatus: vi.fn(),
+  };
+}
+
+describe('gemini filter retry preference', () => {
+  it('treats a missing setting as on and saves the opt-out to config.toml', async () => {
+    const host = makeHost(undefined);
+
+    await applyGeminiFilterRetryChoice(host, false);
+
+    expect(host.harness.setConfig).toHaveBeenCalledWith({ geminiFilterRetry: false });
+    expect(host.showStatus).toHaveBeenCalledWith('Gemini filter retry off.', 'success');
+  });
+
+  it('limits the retry to subagents', async () => {
+    const host = makeHost(true);
+
+    await applyGeminiFilterRetryChoice(host, 'subagents');
+
+    expect(host.harness.setConfig).toHaveBeenCalledWith({ geminiFilterRetry: 'subagents' });
+    expect(host.showStatus).toHaveBeenCalledWith('Gemini filter retry on for subagents only.', 'success');
+  });
+
+  it('turns the retry back on for all agents', async () => {
+    const host = makeHost('subagents');
+
+    await applyGeminiFilterRetryChoice(host, true);
+
+    expect(host.harness.setConfig).toHaveBeenCalledWith({ geminiFilterRetry: true });
+    expect(host.showStatus).toHaveBeenCalledWith('Gemini filter retry on for all agents.', 'success');
+  });
+
+  it('does not rewrite the config when the value is unchanged', async () => {
+    const host = makeHost('subagents');
+
+    await applyGeminiFilterRetryChoice(host, 'subagents');
+
+    expect(host.harness.setConfig).not.toHaveBeenCalled();
+    expect(host.showStatus).toHaveBeenCalledWith('Gemini filter retry already on for subagents only.');
+  });
+
+  it('reports a save failure', async () => {
+    const host = makeHost(true);
+    host.harness.setConfig.mockRejectedValueOnce(new Error('disk full'));
+
+    await applyGeminiFilterRetryChoice(host, false);
+
+    expect(host.showStatus).toHaveBeenCalledWith(
+      'Failed to save the Gemini filter retry setting: disk full',
+      'error',
+    );
+  });
+});
