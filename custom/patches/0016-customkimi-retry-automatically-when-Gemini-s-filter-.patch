+type GeminiFilterRetryHost = {
+  readonly harness: {
+    getConfig(): Promise<{ readonly geminiFilterRetry?: GeminiFilterRetryMode }>;
+    setConfig(patch: { geminiFilterRetry: GeminiFilterRetryMode }): Promise<unknown>;
+  };
+  showStatus(msg: string, color?: string): void;
+};
+
+function geminiFilterRetryModeOf(value: GeminiFilterRetryMode | undefined): GeminiFilterRetryMode {
+  if (value === false || value === 'subagents') return value;
+  return true;
+}
+
+function describeGeminiFilterRetryMode(mode: GeminiFilterRetryMode): string {
+  if (mode === 'subagents') return 'on for subagents only';
+  return mode ? 'on for all agents' : 'off';
+}
+
+export async function showGeminiFilterRetryPicker(host: SlashCommandHost): Promise<void> {
+  let currentValue: GeminiFilterRetryMode;
+  try {
+    currentValue = geminiFilterRetryModeOf((await host.harness.getConfig()).geminiFilterRetry);
