+++ b/packages/agent-core-v2/test/features/geminiFilterRetry/geminiFilterRetry.test.ts
@@ -0,0 +1,300 @@
+import { afterEach, describe, expect, it } from 'vitest';
+
+import { TurnStarted } from '#/agent/loop/turnEvents';
+import { WarningIssued } from '#/agent/profile/profileOps';
+import { IEventBus } from '#/app/event/eventBus';
+import { IAgentContextMemoryService } from '#/agent/contextMemory/contextMemory';
+import type { ContextMessage } from '#/agent/contextMemory/types';
+import { IAgentProfileService } from '#/agent/profile/profile';
+import { IAgentLifecycleService } from '#/session/agentLifecycle/agentLifecycle';
+import { runAgentTurn } from '#/session/subagent/runAgentTurn';
+import {
+  containsGeminiBlockNotice,
+  expandSpintax,
+  geminiFilterRetryAppliesTo,
+  geminiFilterRetryPrompt,
+  isGeminiBlockError,
+  isGeminiBlockReply,
+  isGeminiFilterRetryOrigin,
+} from '#/features/geminiFilterRetry/geminiFilterRetry';
+
+import { createTestAgent, type TestAgentContext } from '../../harness';
+
+const BLOCK_NOTICE =
+  "This request was blocked by Gemini's filters. They can occasionally trigger by mistake on safe coding, security, or biology-related queries. Please try rephrasing your prompt. You can send feedback or read more about our policies here.";
+
+const GEMINI_PROVIDER = { type: 'openai_responses', model: 'gemini-4-carbon-high', apiKey: 'k', baseUrl: 'https://forwarder.test/v1' } as const;
+
+function seeded(values: readonly number[]): () => number {
+  let index = 0;
+  return () => values[index++ % values.length] ?? 0;
+}
+
+describe('gemini filter retry detection', () => {
+  it('recognises the Gemini block notice', () => {
+    expect(containsGeminiBlockNotice(BLOCK_NOTICE)).toBe(true);
+    expect(containsGeminiBlockNotice(BLOCK_NOTICE.replace("'", '’'))).toBe(true);
+    expect(containsGeminiBlockNotice('Error: blocked by GEMINI’S FILTERS')).toBe(true);
+    expect(containsGeminiBlockNotice('Please try rephrasing your prompt.')).toBe(false);
+    expect(containsGeminiBlockNotice('The build is blocked by a failing filter test.')).toBe(false);
+  });
+
+  it('treats only a short reply carrying the notice as a blocked reply', () => {
+    expect(isGeminiBlockReply(`  ${BLOCK_NOTICE}\n`)).toBe(true);
+    expect(isGeminiBlockReply('')).toBe(false);
+    expect(isGeminiBlockReply(`Here is the fix.\n${'x'.repeat(1_000)}\nIt quotes "${BLOCK_NOTICE}"`)).toBe(false);
+  });
+
+  it('matches failed requests by notice text, and filtered empty replies only on Gemini models', () => {
+    expect(isGeminiBlockError({ kind: 'status', message: `Error code: 400 - ${BLOCK_NOTICE}` }, false)).toBe(true);
+    expect(isGeminiBlockError({ kind: 'unknown', message: BLOCK_NOTICE }, false)).toBe(true);
+    const filtered = {
+      kind: 'empty_response',
+      message: 'The API returned an empty response (no content, no tool calls).',
+      finishReason: 'filtered',
+    };
+    expect(isGeminiBlockError(filtered, true)).toBe(true);
+    expect(isGeminiBlockError(filtered, false)).toBe(false);
+    expect(
+      isGeminiBlockError(
+        { kind: 'empty_response', message: 'Provider stop details: finishReason=filtered, rawFinishReason=SAFETY.' },
+        true,
+      ),
+    ).toBe(true);
+    expect(isGeminiBlockError({ kind: 'connection', message: 'Connection reset' }, true)).toBe(false);
+    expect(isGeminiBlockError(undefined, true)).toBe(false);
+  });
+
+  it('applies to all agents, subagents only, or none', () => {
+    expect(geminiFilterRetryAppliesTo(undefined, true)).toBe(true);
+    expect(geminiFilterRetryAppliesTo(true, true)).toBe(true);
+    expect(geminiFilterRetryAppliesTo(true, false)).toBe(true);
+    expect(geminiFilterRetryAppliesTo('subagents', true)).toBe(false);
+    expect(geminiFilterRetryAppliesTo('subagents', false)).toBe(true);
+    expect(geminiFilterRetryAppliesTo(false, true)).toBe(false);
+    expect(geminiFilterRetryAppliesTo(false, false)).toBe(false);
+  });
+
+  it('only recognises its own system trigger origin', () => {
+    expect(isGeminiFilterRetryOrigin({ kind: 'system_trigger', name: 'gemini_filter_retry' })).toBe(true);
+    expect(isGeminiFilterRetryOrigin({ kind: 'system_trigger', name: 'goal_continuation' })).toBe(false);
+    expect(isGeminiFilterRetryOrigin({ kind: 'user' })).toBe(false);
+    expect(isGeminiFilterRetryOrigin(undefined)).toBe(false);
+  });
+});
+
+describe('gemini filter retry spintax', () => {
+  it('expands nested groups and tidies spacing and capitalisation', () => {
+    expect(expandSpintax('{Please|Kindly} {continue|resume}{ now|}{.|!}', seeded([0]))).toBe('Please continue now.');
+    expect(expandSpintax('{Please|} {continue|resume}{ now|}{.|!}', seeded([0.99]))).toBe('Resume!');
+    expect(expandSpintax('{What happened|Hm}? {|ok} {go {on|ahead}|carry on}.', seeded([0, 0, 0.99, 0]))).toBe(
+      'What happened? Go ahead.',
+    );
+  });
+
+  it('always produces a clean, non-empty continue prompt', () => {
+    const seen = new Set<string>();
+    for (let seed = 0; seed < 400; seed += 1) {
+      let state = seed * 7919 + 17;
+      const random = () => {
+        state = (state * 1103515245 + 12345) % 2147483648;
+        return state / 2147483648;
+      };
+      const prompt = geminiFilterRetryPrompt(random);
+      expect(prompt).not.toMatch(/[{}|]/);
+      expect(prompt).not.toMatch(/\s{2,}|\s[.!?,]|^\s|\s$/);
+      expect(prompt).toMatch(/^[A-Z]/);
+      expect(prompt.length).toBeGreaterThan(3);
+      seen.add(prompt);
+    }
+    expect(seen.size).toBeGreaterThan(40);
+  });
+});
+
+describe('AgentGeminiFilterRetryService', () => {
+  let ctx: TestAgentContext | undefined;
+
+  afterEach(async () => {
+    await ctx?.dispose();
+    ctx = undefined;
+  });
+
+  function watch(agent: TestAgentContext): { readonly started: TurnStarted[]; readonly warnings: WarningIssued[] } {
+    const bus = agent.get(IEventBus);
+    const started: TurnStarted[] = [];
+    const warnings: WarningIssued[] = [];
+    bus.subscribe(TurnStarted, (event) => started.push(event));
+    bus.subscribe(WarningIssued, (event) => warnings.push(event));
+    return { started, warnings };
+  }
+
+  function textOf(message: ContextMessage | undefined): string {
+    return message?.content.map((part) => (part.type === 'text' ? part.text : '')).join('') ?? '';
+  }
+
+  function retryMessages(history: readonly ContextMessage[]): ContextMessage[] {
+    return history.filter((message) => isGeminiFilterRetryOrigin(message.origin as { kind: string; name?: string } | undefined));
+  }
+
+  it('continues the same turn with a spintax prompt when the reply is the block notice', async () => {
+    ctx = createTestAgent();
+    ctx.configure();
+    const events = watch(ctx);
+    ctx.mockNextResponse({ type: 'text', text: BLOCK_NOTICE });
+    ctx.mockNextResponse({ type: 'text', text: 'Resumed the work.' });
+
+    await ctx.rpc.prompt({ input: [{ type: 'text', text: 'Refactor the parser' }] });
+    await ctx.untilTurnEnd();
+
+    expect(events.started).toHaveLength(1);
+    const history = ctx.contextData().history;
+    const retries = retryMessages(history);
+    expect(retries).toHaveLength(1);
+    expect(retries[0]?.role).toBe('user');
+    const retryText = textOf(retries[0]);
+    expect(retryText).toMatch(/^[A-Z]/);
+    expect(history.at(-2)).toBe(retries[0]);
+    expect(textOf(history.at(-1))).toBe('Resumed the work.');
+    expect(events.warnings.map((warning) => warning.code)).toEqual(['gemini_filter_retry']);
+    expect(events.warnings[0]?.message).toContain('(1/5)');
+    expect(events.warnings[0]?.message).toContain(`"${retryText}"`);
+  });
+
+  it('re-asks with a spintax prompt when a Gemini request fails with the notice', async () => {
+    ctx = createTestAgent();
+    ctx.configure({ provider: GEMINI_PROVIDER });
+    const events = watch(ctx);
+    ctx.mockNextProviderResponse({ error: new Error(BLOCK_NOTICE) });
+    ctx.mockNextResponse({ type: 'text', text: 'Back on track.' });
+
+    await ctx.rpc.prompt({ input: [{ type: 'text', text: 'Audit the auth code' }] });
+    await ctx.untilTurnEnd();
+
+    expect(events.started).toHaveLength(1);
+    expect(events.warnings.map((warning) => warning.code)).toEqual(['gemini_filter_retry']);
+    const retryText = /with "(.*)"$/.exec(events.warnings[0]?.message ?? '')?.[1] ?? '';
+    expect(retryText).toMatch(/^[A-Z]/);
+    expect(ctx.llmCalls).toHaveLength(2);
+    const lastSent = ctx.llmCalls[1]?.history.at(-1);
+    expect(lastSent?.role).toBe('user');
+    expect(JSON.stringify(lastSent?.content)).toContain(retryText);
+    const history = ctx.contextData().history;
+    expect(retryMessages(history).map(textOf)).toEqual([retryText]);
+    expect(textOf(history.at(-1))).toBe('Back on track.');
+  });
+
+  it('stops after five retries of a failing Gemini request and fails the turn', async () => {
+    ctx = createTestAgent();
+    ctx.configure({ provider: GEMINI_PROVIDER });
+    const events = watch(ctx);
+    for (let index = 0; index < 6; index += 1) ctx.mockNextProviderResponse({ error: new Error(BLOCK_NOTICE) });
+
+    await ctx.rpc.prompt({ input: [{ type: 'text', text: 'Audit the auth code' }] });
+    await ctx.untilTurnEnd();
+
+    expect(ctx.llmCalls).toHaveLength(6);
+    expect(retryMessages(ctx.contextData().history)).toHaveLength(5);
+    expect(events.warnings.at(-1)?.message).toContain('stopped retrying');
+  });
+
+  it('gives up after five retries in one turn and counts again from the next prompt', async () => {
+    ctx = createTestAgent();
+    ctx.configure();
+    const events = watch(ctx);
+    for (let index = 0; index < 6; index += 1) ctx.mockNextResponse({ type: 'text', text: BLOCK_NOTICE });
+
+    await ctx.rpc.prompt({ input: [{ type: 'text', text: 'Write the mitigation' }] });
+    await ctx.untilTurnEnd();
+
+    expect(events.started).toHaveLength(1);
+    expect(retryMessages(ctx.contextData().history)).toHaveLength(5);
+    expect(events.warnings.map((warning) => /\((\d)\/5\)/.exec(warning.message)?.[1] ?? 'stop')).toEqual([
+      '1', '2', '3', '4', '5', 'stop',
+    ]);
+
+    ctx.mockNextResponse({ type: 'text', text: BLOCK_NOTICE });
+    ctx.mockNextResponse({ type: 'text', text: 'Done.' });
+    await ctx.rpc.prompt({ input: [{ type: 'text', text: 'Try again' }] });
+    await ctx.untilTurnEnd();
+    expect(events.warnings.at(-1)?.message).toContain('(1/5)');
+    expect(textOf(ctx.contextData().history.at(-1))).toBe('Done.');
+  });
+
+  async function runSubagent(agent: TestAgentContext, prompt: string) {
+    const lifecycle = agent.get(IAgentLifecycleService);
+    const sub = await lifecycle.create({ agentId: 'agent-1' });
+    const handle = lifecycle.handleOf(sub.agentId);
+    if (handle === undefined) throw new Error('subagent handle missing');
+    handle.accessor.get(IAgentProfileService).update({
+      modelAlias: 'mock-model',
+      systemPrompt: 'You are a subagent.',
+      thinkingLevel: 'off',
+    });
+    const run = await runAgentTurn(handle, { kind: 'prompt', prompt }, { signal: new AbortController().signal });
+    const completion = await run.completion;
+    const history = handle.accessor.get(IAgentContextMemoryService).get();
+    await lifecycle.remove(sub);
+    return { completion, history };
+  }
+
+  it('retries inside a subagent run so the parent receives the real answer', async () => {
+    ctx = createTestAgent();
+    ctx.configure();
+    ctx.mockNextResponse({ type: 'text', text: BLOCK_NOTICE });
+    ctx.mockNextResponse({ type: 'text', text: 'Subagent summary.' });
+
+    const { completion, history } = await runSubagent(ctx, 'Investigate the crash');
+
+    expect(completion.summary).toBe('Subagent summary.');
+    expect(retryMessages(history)).toHaveLength(1);
+    expect(retryMessages(ctx.contextData().history)).toHaveLength(0);
+  });
+
+  it('in subagents-only mode retries subagents but leaves the main conversation stopped', async () => {
+    ctx = createTestAgent({ initialConfig: { geminiFilterRetry: 'subagents' } });
+    ctx.configure();
+    const events = watch(ctx);
+    ctx.mockNextResponse({ type: 'text', text: BLOCK_NOTICE });
+
+    await ctx.rpc.prompt({ input: [{ type: 'text', text: 'Hello' }] });
+    await ctx.untilTurnEnd();
+
+    expect(retryMessages(ctx.contextData().history)).toEqual([]);
+    expect(events.warnings).toEqual([]);
+    expect(textOf(ctx.contextData().history.at(-1))).toBe(BLOCK_NOTICE);
+
+    ctx.mockNextResponse({ type: 'text', text: BLOCK_NOTICE });
+    ctx.mockNextResponse({ type: 'text', text: 'Subagent summary.' });
+    const { completion, history } = await runSubagent(ctx, 'Investigate the crash');
+
+    expect(completion.summary).toBe('Subagent summary.');
+    expect(retryMessages(history)).toHaveLength(1);
+  });
+
+  it('does nothing when the setting is off', async () => {
+    ctx = createTestAgent({ initialConfig: { geminiFilterRetry: false } });
+    ctx.configure();
+    const events = watch(ctx);
+    ctx.mockNextResponse({ type: 'text', text: BLOCK_NOTICE });
+
+    await ctx.rpc.prompt({ input: [{ type: 'text', text: 'Hello' }] });
+    await ctx.untilTurnEnd();
+
+    expect(retryMessages(ctx.contextData().history)).toEqual([]);
+    expect(events.warnings).toEqual([]);
+    expect(textOf(ctx.contextData().history.at(-1))).toBe(BLOCK_NOTICE);
+  });
+
+  it('leaves ordinary replies alone', async () => {
+    ctx = createTestAgent();
+    ctx.configure({ provider: GEMINI_PROVIDER });
+    const events = watch(ctx);
+    ctx.mockNextResponse({ type: 'text', text: `The tool printed: "${BLOCK_NOTICE}" ${'and more context. '.repeat(60)}` });
+
+    await ctx.rpc.prompt({ input: [{ type: 'text', text: 'What does this error mean?' }] });
+    await ctx.untilTurnEnd();
+
+    expect(retryMessages(ctx.contextData().history)).toEqual([]);
+    expect(events.warnings).toEqual([]);
+  });
+});
