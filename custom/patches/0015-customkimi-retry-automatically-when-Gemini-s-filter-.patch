+type GeminiFilterRetryHost = {
+  readonly harness: {
+    getConfig(): Promise<{ readonly geminiFilterRetry?: GeminiFilterRetryMode }>;
+    setConfig(patch: { geminiFilterRetry: GeminiFilterRetryMode }): Promise<unknown>;
+  };
+  showStatus(msg: string, color?: string): void;
+};
+
+function geminiFilterRetryModeOf(value: GeminiFilterRetryMode | undefined): GeminiFilterRetryMode {
+  if (value === false || value === 'subagents') return value;
+  return true;
+}
+
+function describeGeminiFilterRetryMode(mode: GeminiFilterRetryMode): string {
+  if (mode === 'subagents') return 'on for subagents only';
+  return mode ? 'on for all agents' : 'off';
+}
+
+export async function showGeminiFilterRetryPicker(host: SlashCommandHost): Promise<void> {
+  let currentValue: GeminiFilterRetryMode;
+  try {
+    currentValue = geminiFilterRetryModeOf((await host.harness.getConfig()).geminiFilterRetry);
+  } catch (error) {
+    host.showError(`Failed to load the Gemini filter retry setting: ${formatErrorMessage(error)}`);
+    return;
+  }
+  host.mountEditorReplacement(
+    new GeminiFilterRetrySelectorComponent({
+      currentValue,
+      onSelect: (value) => {
+        host.restoreEditor();
+        void applyGeminiFilterRetryChoice(host, value);
+      },
+      onCancel: () => {
+        host.restoreEditor();
+      },
+    }),
+  );
+}
+
+export async function applyGeminiFilterRetryChoice(
+  host: GeminiFilterRetryHost,
+  mode: GeminiFilterRetryMode,
+): Promise<void> {
+  try {
+    const current = geminiFilterRetryModeOf((await host.harness.getConfig()).geminiFilterRetry);
+    if (current === mode) {
+      host.showStatus(`Gemini filter retry already ${describeGeminiFilterRetryMode(mode)}.`);
+      return;
+    }
+    await host.harness.setConfig({ geminiFilterRetry: mode });
+  } catch (error) {
+    host.showStatus(
+      `Failed to save the Gemini filter retry setting: ${formatErrorMessage(error)}`,
+      'error',
+    );
+    return;
+  }
+  host.showStatus(`Gemini filter retry ${describeGeminiFilterRetryMode(mode)}.`, 'success');
+}
