+import { Feature } from '#/features/feature';
+import { registerFeature } from '#/features/featureRegistry';
+import {
+  AgentGeminiFilterRetryService,
+  IAgentGeminiFilterRetryService,
+} from '#/features/geminiFilterRetry/geminiFilterRetryService';
+
+export class GeminiFilterRetryFeature extends Feature {
+  static override readonly name = 'geminiFilterRetry';
+
+  constructor() {
+    super();
+    this.contributeAgentService(IAgentGeminiFilterRetryService, AgentGeminiFilterRetryService);
