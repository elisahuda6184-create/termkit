@@ -0,0 +1,161 @@
+import { createDecorator } from '#/_base/di/instantiation';
+import { Service } from '#/_base/di/service';
+import type { ContextMessage } from '#/agent/contextMemory/types';
+import {
+  IAgentLoopService,
+  type AfterStepContext,
+  type LoopLlmRecoveryContext,
+  type LoopLlmRecoveryProposal,
+} from '#/agent/loop/loop';
+import { TurnStarted } from '#/agent/loop/turnEvents';
+import { IAgentProfileService } from '#/agent/profile/profile';
+import { WarningIssued } from '#/agent/profile/profileOps';
+import { IAgentScopeContext } from '#/agent/scopeContext/scopeContext';
+import { IConfigService } from '#/app/config/config';
+import { IEventBus } from '#/app/event/eventBus';
+import { IModelCatalog } from '#/llm-adapter/model/catalog';
+import { MAIN_AGENT_ID } from '#/session/agentLifecycle/agentLifecycle';
+import { IEventDispatcher } from '#/state/eventDispatcher';
+
+import {
+  GEMINI_FILTER_RETRY_MAX_ATTEMPTS,
+  GEMINI_FILTER_RETRY_ORIGIN,
+  GEMINI_FILTER_RETRY_SECTION,
+  GEMINI_FILTER_RETRY_STRATEGY,
+  type GeminiFilterRetryConfig,
+  geminiFilterRetryAppliesTo,
+  geminiFilterRetryPrompt,
+  isGeminiBlockError,
+  isGeminiFilterRetryOrigin,
+  isGeminiBlockReply,
+  isGeminiModelName,
+} from './geminiFilterRetry';
+
+export interface IAgentGeminiFilterRetryService {
+  readonly _serviceBrand: undefined;
+}
+
+export const IAgentGeminiFilterRetryService = createDecorator<IAgentGeminiFilterRetryService>(
+  'agentGeminiFilterRetryService',
+);
+
+function lastAssistantBlockReply(history: readonly ContextMessage[]): boolean {
+  const last = history.at(-1);
+  if (last?.role !== 'assistant' || last.toolCalls.length > 0) return false;
+  return isGeminiBlockReply(
+    last.content.map((part) => (part.type === 'text' ? part.text : '')).join(''),
+  );
+}
+
+function retryMessage(prompt: string): ContextMessage {
+  return {
+    role: 'user',
+    content: [{ type: 'text', text: prompt }],
+    origin: GEMINI_FILTER_RETRY_ORIGIN,
+  };
+}
+
+export class AgentGeminiFilterRetryService extends Service implements IAgentGeminiFilterRetryService {
+  declare readonly _serviceBrand: undefined;
+
+  private attemptsInTurn = 0;
+  private gaveUpInTurn = false;
+
+  constructor(
+    @IEventBus eventBus: IEventBus,
+    @IAgentScopeContext private readonly scopeContext: IAgentScopeContext,
+    @IAgentLoopService private readonly loop: IAgentLoopService,
+    @IAgentProfileService private readonly profile: IAgentProfileService,
+    @IModelCatalog private readonly catalog: IModelCatalog,
+    @IConfigService private readonly configService: IConfigService,
+    @IEventDispatcher private readonly dispatcher: IEventDispatcher,
+  ) {
+    super();
+    this._register(
+      eventBus.subscribe(TurnStarted, (event) => {
+        if (isGeminiFilterRetryOrigin(event.origin)) return;
+        this.attemptsInTurn = 0;
+        this.gaveUpInTurn = false;
+      }),
+    );
+    this._register(
+      this.loop.hooks.onDidFinishStep.register('gemini-filter-retry', async (step, next) => {
+        this.afterStep(step);
+        await next();
+      }),
+    );
+    this._register(
+      this.loop.registerLlmRecovery({
+        id: 'gemini-filter-retry',
+        propose: (failure) => this.proposeRetry(failure),
+      }),
+    );
+  }
+
+  private enabled(): boolean {
+    return geminiFilterRetryAppliesTo(
+      this.configService.get<GeminiFilterRetryConfig>(GEMINI_FILTER_RETRY_SECTION),
+      this.scopeContext.agentId === MAIN_AGENT_ID,
+    );
+  }
+
+  private usesGeminiModel(): boolean {
+    try {
+      if (!this.profile.hasModel()) return false;
+      const alias = this.profile.getModel();
+      const model = this.catalog.get(alias);
+      return isGeminiModelName(alias, model.providerName, model.spec.name);
+    } catch {
+      return false;
+    }
+  }
+
+  private afterStep(step: AfterStepContext): void {
+    if (!this.enabled() || step.signal.aborted || step.stopTurn) return;
+    const blocked =
+      lastAssistantBlockReply(this.loop.history()) ||
+      (step.finishReason === 'filtered' && this.usesGeminiModel());
+    if (!blocked) return;
+    const prompt = this.nextPrompt();
+    if (prompt === undefined) return;
+    this.loop.notify({ message: retryMessage(prompt) });
+  }
+
+  private proposeRetry(failure: LoopLlmRecoveryContext): LoopLlmRecoveryProposal | undefined {
+    if (!this.enabled() || !isGeminiBlockError(failure.error, this.usesGeminiModel())) return undefined;
+    const prompt = this.nextPrompt();
+    if (prompt === undefined) return undefined;
+    return {
+      strategy: GEMINI_FILTER_RETRY_STRATEGY,
+      action: `continue ${String(this.attemptsInTurn)}/${String(GEMINI_FILTER_RETRY_MAX_ATTEMPTS)}`,
+      appendMessages: [retryMessage(prompt)],
+    };
+  }
+
+  private nextPrompt(): string | undefined {
+    if (this.attemptsInTurn >= GEMINI_FILTER_RETRY_MAX_ATTEMPTS) {
+      if (!this.gaveUpInTurn) {
+        this.gaveUpInTurn = true;
+        this.warn(
+          `Gemini's filter blocked the reply ${String(GEMINI_FILTER_RETRY_MAX_ATTEMPTS + 1)} times in a row; stopped retrying automatically. Rephrase the prompt or turn off "Gemini filter retry" in /settings.`,
+        );
+      }
+      return undefined;
+    }
+    this.attemptsInTurn += 1;
+    const prompt = geminiFilterRetryPrompt();
+    this.warn(
+      `Gemini's filter blocked the reply; retrying automatically (${String(this.attemptsInTurn)}/${String(GEMINI_FILTER_RETRY_MAX_ATTEMPTS)}) with "${prompt}"`,
+    );
+    return prompt;
+  }
+
+  private warn(message: string): void {
+    try {
+      void this.dispatcher.dispatch(
+        new WarningIssued({ agentId: this.scopeContext.agentId, code: GEMINI_FILTER_RETRY_STRATEGY, message }),
+      );
+    } catch {
+    }
+  }
+}
