+import { ChoicePickerComponent, type ChoiceOption } from './choice-picker';
+
+export type GeminiFilterRetryMode = boolean | 'subagents';
+
+const GEMINI_FILTER_RETRY_OPTIONS: readonly ChoiceOption[] = [
+  {
+    value: 'on',
+    label: 'On',
+    description:
+      "When Gemini's filter blocks a reply, the main agent and every subagent send a random \"continue\" prompt automatically (up to 5 times in a row).",
+  },
+  {
+    value: 'subagents',
+    label: 'Subagents only',
+    description: 'Subagents retry on their own; the main conversation stops on the block notice and waits for you.',
+  },
+  {
+    value: 'off',
+    label: 'Off',
+    description: 'Every agent stops on the block notice.',
+  },
+];
+
+function choiceOf(mode: GeminiFilterRetryMode): string {
+  if (mode === 'subagents') return 'subagents';
+  return mode ? 'on' : 'off';
+}
+
+function modeOf(choice: string): GeminiFilterRetryMode {
+  if (choice === 'subagents') return 'subagents';
+  return choice === 'on';
+}
+
+export interface GeminiFilterRetrySelectorOptions {
+  readonly currentValue: GeminiFilterRetryMode;
+  readonly onSelect: (value: GeminiFilterRetryMode) => void;
+  readonly onCancel: () => void;
+}
+
+export class GeminiFilterRetrySelectorComponent extends ChoicePickerComponent {
+  constructor(opts: GeminiFilterRetrySelectorOptions) {
+    super({
+      title: 'Gemini filter retry',
+      options: [...GEMINI_FILTER_RETRY_OPTIONS],
+      currentValue: choiceOf(opts.currentValue),
+      onSelect: (value) => {
+        opts.onSelect(modeOf(value));
+      },
+      onCancel: opts.onCancel,
+    });
+  }
+}
