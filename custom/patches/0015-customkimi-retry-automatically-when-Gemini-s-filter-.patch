@@ -0,0 +1,102 @@
+import { z } from 'zod';
+
+import type { SystemTriggerOrigin } from '#/agent/contextMemory/types';
+import { registerConfigSection } from '#/app/config/configSectionContributions';
+
+export const GEMINI_FILTER_RETRY_SECTION = 'geminiFilterRetry';
+
+export const GEMINI_FILTER_RETRY_SUBAGENTS_ONLY = 'subagents';
+
+export const GeminiFilterRetryConfigSchema = z
+  .union([z.boolean(), z.literal(GEMINI_FILTER_RETRY_SUBAGENTS_ONLY)])
+  .optional();
+
+export type GeminiFilterRetryConfig = z.infer<typeof GeminiFilterRetryConfigSchema>;
+
+export function geminiFilterRetryAppliesTo(mode: GeminiFilterRetryConfig, mainAgent: boolean): boolean {
+  if (mode === false) return false;
+  if (mode === GEMINI_FILTER_RETRY_SUBAGENTS_ONLY) return !mainAgent;
+  return true;
+}
+
+registerConfigSection(GEMINI_FILTER_RETRY_SECTION, GeminiFilterRetryConfigSchema, {
+  defaultValue: true,
+});
+
+export const GEMINI_FILTER_RETRY_MAX_ATTEMPTS = 5;
+
+export const GEMINI_FILTER_RETRY_STRATEGY = 'gemini_filter_retry';
+
+export const GEMINI_FILTER_RETRY_ORIGIN: SystemTriggerOrigin = {
+  kind: 'system_trigger',
+  name: 'gemini_filter_retry',
+};
+
+export function isGeminiFilterRetryOrigin(origin: { readonly kind: string; readonly name?: unknown } | undefined): boolean {
+  return origin?.kind === GEMINI_FILTER_RETRY_ORIGIN.kind && origin.name === GEMINI_FILTER_RETRY_ORIGIN.name;
+}
+
+const BLOCK_NOTICE_PATTERNS: readonly RegExp[] = [
+  /blocked by gemini\W{0,2}s\s+filters/i,
+  /can occasionally trigger by mistake on safe coding/i,
+];
+
+const MAX_BLOCK_REPLY_LENGTH = 800;
+
+export function containsGeminiBlockNotice(text: string): boolean {
+  return BLOCK_NOTICE_PATTERNS.some((pattern) => pattern.test(text));
+}
+
+export function isGeminiBlockReply(text: string): boolean {
+  const trimmed = text.trim();
+  return trimmed.length > 0 && trimmed.length <= MAX_BLOCK_REPLY_LENGTH && containsGeminiBlockNotice(trimmed);
+}
+
+export function isGeminiModelName(...names: readonly (string | undefined)[]): boolean {
+  return names.some((name) => name !== undefined && /gemini/i.test(name));
+}
+
+export interface GeminiBlockErrorShape {
+  readonly kind?: string;
+  readonly message: string;
+  readonly finishReason?: string | null;
+}
+
+export function isGeminiBlockError(error: GeminiBlockErrorShape | undefined, geminiModel: boolean): boolean {
+  if (error === undefined) return false;
+  if (containsGeminiBlockNotice(error.message)) return true;
+  if (!geminiModel) return false;
+  return (
+    (error.kind === 'empty_response' && error.finishReason === 'filtered') ||
+    /finishReason=filtered\b/.test(error.message)
+  );
+}
+
+const CONTINUE_SPINTAX: readonly string[] = [
+  '{Please|Kindly|Ok,|Alright,|Okay,} {continue|carry on|keep going|go on|proceed|resume}{ where you left off| from where you stopped| with the task| with what you were doing|}{.|!|}',
+  "{What's going on|What happened|Hmm, what happened there|Looks like you stopped|Something interrupted you}{?|...} {Please|Kindly|} {continue|carry on|keep going|resume|pick it back up}{ where you left off| with the task| from there|}{.|!|}",
+  '{Continue|Keep going|Carry on|Go ahead and continue|Resume}{ please|}{ where you left off| with the task|}{.|!|}',
+  '{You stopped|Your reply got cut off|That got interrupted|The last reply did not come through}{ there|}{.|!} {Please|} {continue|pick up|carry on|keep going}{ where you left off| from there| with the work|}{.|}',
+  '{Go on|Keep at it|Carry on}{, please|}{.|!} {Continue|Proceed} {with the next step|with the task|where you left off}{.|}',
+];
+
+export function expandSpintax(template: string, random: () => number = Math.random): string {
+  const group = /\{([^{}]*)\}/;
+  let out = template;
+  for (let match = group.exec(out); match !== null; match = group.exec(out)) {
+    const options = (match[1] ?? '').split('|');
+    const pick = options[Math.min(options.length - 1, Math.floor(random() * options.length))] ?? '';
+    out = out.slice(0, match.index) + pick + out.slice(match.index + match[0].length);
+  }
+  return out
+    .replaceAll(/\s+/g, ' ')
+    .replaceAll(/\s+([.!?,])/g, '$1')
+    .replaceAll(/,([.!?])/g, '$1')
+    .trim()
+    .replaceAll(/(^|[.!?]\s+)([a-z])/g, (_match: string, lead: string, letter: string) => lead + letter.toUpperCase());
+}
+
+export function geminiFilterRetryPrompt(random: () => number = Math.random): string {
+  const index = Math.min(CONTINUE_SPINTAX.length - 1, Math.floor(random() * CONTINUE_SPINTAX.length));
+  return expandSpintax(CONTINUE_SPINTAX[index] ?? CONTINUE_SPINTAX[0] ?? 'Please continue.', random);
+}
