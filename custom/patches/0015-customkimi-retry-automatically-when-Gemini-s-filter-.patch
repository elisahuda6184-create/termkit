+  registerLlmRecovery(recovery: LoopLlmRecovery): IDisposable {
+    this.deleteLlmRecovery(recovery.id);
+    this.llmRecoveries.push(recovery);
+    return toDisposable(() => {
+      this.deleteLlmRecovery(recovery.id);
+    });
+  }
+
+  private deleteLlmRecovery(id: string): void {
+    const index = this.llmRecoveries.findIndex((entry) => entry.id === id);
+    if (index >= 0) this.llmRecoveries.splice(index, 1);
+  }
+
+  private coreLlmRecoveries(): readonly LlmRecovery[] {
+    return this.llmRecoveries.map((recovery) => ({
+      propose: (context) => {
+        let proposal: LoopLlmRecoveryProposal | undefined;
+        try {
+          proposal = recovery.propose({
+            error: {
+              kind: context.error.kind,
+              message: context.error.message,
+              finishReason:
+                'finishReason' in context.error ? context.error.finishReason : undefined,
+            },
+            messages: context.request.content.messages,
+            appliedRecoveries: context.appliedRecoveries,
+          });
+        } catch {
+          return undefined;
+        }
+        if (proposal === undefined) return undefined;
+        const appendMessages = proposal.appendMessages ?? [];
+        return {
+          strategy: proposal.strategy,
+          action: proposal.action,
+          rewrite:
+            appendMessages.length === 0
+              ? undefined
+              : (request) => ({
+                  ...request,
+                  content: {
+                    ...request.content,
+                    messages: [...request.content.messages, ...appendMessages],
+                  },
+                }),
+          beforeNextAttempt:
+            appendMessages.length === 0
+              ? undefined
+              : () => {
+                  this.pendingRecoveryMessages.push(...appendMessages);
+                  for (const message of appendMessages) {
+                    void this.dispatcher.dispatch(
+                      new ContextAppendMessage({ agentId: this.scopeContext.agentId, message }),
+                    );
+                  }
+                },
+        };
+      },
+    }));
+  }
+
+  private flushRecoveryMessages(beforeAssistant: boolean): void {
+    const pending = this.pendingRecoveryMessages;
+    if (pending.length === 0) return;
+    const loop = this.loop;
+    if (loop === undefined) return;
+    this.pendingRecoveryMessages = [];
+    const messages = loop.state.messages;
+    const index =
+      beforeAssistant && messages.at(-1)?.role === 'assistant' ? messages.length - 1 : messages.length;
+    const ack = loop.setContext([
+      ...messages.slice(0, index),
+      ...historyFromContext(pending),
+      ...messages.slice(index),
+    ], 'llm-recovery');
+    if (ack?.type === 'context.rejected') {
+      this.pendingRecoveryMessages = [...pending, ...this.pendingRecoveryMessages];
+    }
+  }
+
   private deleteErrorHandler(id: string): boolean {
     const index = this.errorHandlers.findIndex((entry) => entry.id === id);
