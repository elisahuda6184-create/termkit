diff --git a/packages/core/src/llm/protocol/kit/params.ts b/packages/core/src/llm/protocol/kit/params.ts
index 8c2aa96290099fde7813edf271f5fff0dee3ad0d..32cae49acfa8b8b60d66cd407d3c53ba2987268e 100644
--- a/packages/core/src/llm/protocol/kit/params.ts
+++ b/packages/core/src/llm/protocol/kit/params.ts
@@ -8,3 +8,15 @@ export function withExtras<TParams extends object>(
     assign(params as Record<string, unknown>, (extras ?? {}) as Record<string, unknown>),
   ) as TParams;
 }
+
+export function withExtraBody<TParams extends object>(
+  params: TParams,
+  extraBody: Readonly<Record<string, unknown>> | undefined,
+): TParams {
+  if (extraBody === undefined) return params;
+  const merged: Record<string, unknown> = { ...extraBody };
+  for (const [key, value] of Object.entries(params)) {
+    if (value !== undefined) merged[key] = value;
+  }
+  return shake(merged) as TParams;
+}
