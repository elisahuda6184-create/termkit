+        baseUrl: FORWARDER_BASE,
+        apiKeyEnv: MUSE_FORWARDER_KEY_ENV,
+      },
+      muse: {
+        type: 'openai_responses',
+        baseUrl: 'https://muse.example.test:8788/v1',
+        apiKeyEnv: MUSE_FORWARDER_KEY_ENV,
+      },
+    },
+    models,
+  } as unknown as ManagedKimiConfigShape;
+}
