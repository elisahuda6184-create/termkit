+interface Call {
+  readonly url: string;
+  readonly init: RequestInit;
+}
+
+function recordingFetch(
+  respond: () => Response | Promise<Response> = () => Response.json({ data: SAMPLE_CATALOG }),
+): { readonly calls: Call[]; readonly fetchImpl: typeof fetch } {
+  const calls: Call[] = [];
+  const fetchImpl = (async (url: string, init: RequestInit) => {
+    calls.push({ url, init });
+    return respond();
+  }) as typeof fetch;
+  return { calls, fetchImpl };
+}
+
+function makeHost(initial: ManagedKimiConfigShape): {
+  readonly host: RefreshProviderHost;
+  readonly current: () => ManagedKimiConfigShape;
+  readonly setConfig: ReturnType<
+    typeof vi.fn<(patch: ManagedKimiConfigShape) => Promise<ManagedKimiConfigShape>>
+  >;
+} {
+  let state = structuredClone(initial);
+  const setConfig = vi.fn(async (patch: ManagedKimiConfigShape) => {
+    state = { ...state, ...patch };
+    return structuredClone(state);
+  });
+  return {
+    host: {
+      getConfig: async () => structuredClone(state),
+      removeProvider: vi.fn(async () => structuredClone(state)),
+      setConfig,
+      resolveOAuthToken: vi.fn(async () => ''),
+      userAgent: 'customkimi-test/1.0',
+    },
+    current: () => structuredClone(state),
+    setConfig,
+  };
+}
+
+function baseConfig(models: Record<string, unknown> = {}): ManagedKimiConfigShape {
+  return {
+    providers: {
+      gemini: {
