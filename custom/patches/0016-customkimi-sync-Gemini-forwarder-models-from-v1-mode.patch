+import type { ManagedKimiConfigShape } from './managed-kimi-code';
+import { readApiErrorMessage } from './api-error';
+import {
+  ENDPOINT_TYPE_BY_PROTOCOL,
+  ENV_OVERLAY_PREFIX,
+  FailureLog,
+  errorMessage,
+  parseEfforts,
+  patchAlias,
+  positiveInteger,
+  readAlias,
+  sameAlias,
+  secondaryModelEffort,
+  subagentEffortProblem,
+  thinkingFields,
+  type AliasMetadata,
+  type CloseRouterEndpointType,
+  type CloseRouterRefreshHost,
+  type SubagentEffort,
+} from './closerouter';
+import { declaredProviderCredential, nonEmptyString } from './provider-credential';
+import { isRecord } from './utils';
+
+export const MUSE_FORWARDER_KEY_ENV = 'MUSE_FORWARDER_KEY';
+export const GEMINI_FORWARDER_KEY_ENV = 'GEMINI_FORWARDER_KEY';
+
+const DEFAULT_REQUEST_TIMEOUT_MS = 10_000;
+const DEFAULT_DEADLINE_MS = 30_000;
+
+const EFFORT_SUFFIX = /^(.*?)-(minimal|low|medium|high|xhigh|max)$/;
+const DISPLAY_EFFORT_SUFFIX = /\s*\((?:minimal|low|medium|high|xhigh|max)\)\s*$/i;
+const CONTROL_CHARS = /[\u0000-\u001F\u007F]/;
+
+export interface GeminiForwarderRefreshOptions {
+  readonly providerId?: string;
+  readonly requestTimeoutMs?: number;
+  readonly deadlineMs?: number;
+  readonly fetchImpl?: typeof fetch;
+  readonly env?: Readonly<Record<string, string | undefined>>;
+}
+
+export interface GeminiForwarderProviderChange {
+  readonly providerId: string;
+  readonly added: number;
+  readonly aliases: number;
+  readonly limits: boolean;
+  readonly efforts: boolean;
+}
+
+export interface GeminiForwarderRefreshResult {
+  readonly config: ManagedKimiConfigShape;
+  readonly changed: ReadonlyArray<GeminiForwarderProviderChange>;
+  readonly unchanged: readonly string[];
+  readonly failed: ReadonlyArray<{ readonly provider: string; readonly reason: string }>;
+}
+
+export interface GeminiForwarderModelFamily {
+  readonly stem: string;
+  readonly canonicalModelId: string;
+  readonly memberIds: ReadonlySet<string>;
+  readonly displayName: string;
+  readonly maxContextSize?: number;
+  readonly maxOutputSize?: number;
+  readonly efforts: readonly string[];
+}
+
+interface GeminiForwarderProviderTarget {
+  readonly providerId: string;
+  readonly modelsUrl: string;
+  readonly apiKey: string;
+  readonly endpointType: CloseRouterEndpointType;
+}
+
+interface RawCatalogEntry {
+  readonly id: string;
+  readonly displayName?: string;
+  readonly maxContextSize?: number;
+  readonly maxOutputSize?: number;
+}
+
+export function geminiForwarderModelsUrl(baseUrl: unknown): string | undefined {
+  const value = nonEmptyString(baseUrl);
+  if (value === undefined) return undefined;
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    return undefined;
+  }
+  if (url.protocol !== 'https:' && url.protocol !== 'http:') return undefined;
+  if (url.search !== '' || url.hash !== '') return undefined;
+  const pathname = url.pathname.replace(/\/+$/, '');
+  return `${url.origin}${pathname}/models`;
+}
+
+export function isGeminiForwarderProvider(providerId: string, provider: Record<string, unknown>): boolean {
+  const apiKeyEnv = nonEmptyString(provider['apiKeyEnv']);
+  if (apiKeyEnv === GEMINI_FORWARDER_KEY_ENV) return true;
+  return apiKeyEnv === MUSE_FORWARDER_KEY_ENV && providerId.toLowerCase().includes('gemini');
+}
+
+export function groupGeminiForwarderModels(entries: readonly unknown[]): GeminiForwarderModelFamily[] {
+  const buckets = new Map<
+    string,
+    {
+      readonly stem: string;
+      readonly items: Array<{ readonly entry: RawCatalogEntry; readonly effort?: string }>;
+    }
+  >();
+
+  for (const raw of entries) {
+    if (!isRecord(raw)) continue;
+    const id = nonEmptyString(raw['id']);
+    if (id === undefined) continue;
+    const entry: RawCatalogEntry = {
+      id,
+      displayName: nonEmptyString(raw['display_name']),
+      maxContextSize: positiveInteger(raw['max_context']) ?? positiveInteger(raw['context_length']),
+      maxOutputSize:
+        positiveInteger(raw['max_output']) ?? positiveInteger(raw['max_output_tokens']),
+    };
+    const match = EFFORT_SUFFIX.exec(id);
+    const stem = match !== null && match[1]!.length > 0 ? match[1]! : id;
+    const effort = match !== null && match[1]!.length > 0 ? match[2]! : undefined;
+    let bucket = buckets.get(stem);
+    if (bucket === undefined) {
+      bucket = { stem, items: [] };
+      buckets.set(stem, bucket);
+    }
+    if (!bucket.items.some((existing) => existing.entry.id === entry.id)) {
+      bucket.items.push({ entry, effort });
+    }
+  }
+
+  const preliminary = [...buckets.values()].map(({ stem, items }) => {
+    const rawEfforts = items
+      .map((item) => item.effort)
+      .filter((effort): effort is string => effort !== undefined);
+    const efforts = parseEfforts(rawEfforts) ?? [];
+    const byEffort = new Map<string, RawCatalogEntry>();
+    for (const item of items) {
+      if (item.effort !== undefined) byEffort.set(item.effort, item.entry);
+    }
+    const canonicalEntry =
+      byEffort.get('high') ??
+      byEffort.get('medium') ??
+      (efforts.length > 0 ? byEffort.get(efforts[efforts.length - 1]!) : undefined) ??
+      items[0]!.entry;
+    const baseDisplay = formatBaseDisplayName(stem, canonicalEntry.displayName, efforts.length > 0);
+    return {
+      stem,
+      canonicalModelId: canonicalEntry.id,
+      memberIds: new Set(items.map((item) => item.entry.id)),
+      baseDisplay,
+      maxContextSize: canonicalEntry.maxContextSize,
+      maxOutputSize: canonicalEntry.maxOutputSize,
+      efforts,
+    };
+  });
+
+  const displayCounts = new Map<string, number>();
+  for (const family of preliminary) {
+    displayCounts.set(family.baseDisplay, (displayCounts.get(family.baseDisplay) ?? 0) + 1);
+  }
+
+  return preliminary.map(({ baseDisplay, ...rest }) => {
+    const collided = (displayCounts.get(baseDisplay) ?? 0) > 1;
+    const displayName =
+      collided && !stemMatchesDisplay(rest.stem, baseDisplay)
+        ? `${baseDisplay} [${rest.stem}]`
+        : baseDisplay;
+    return {
+      ...rest,
+      displayName: withAgySuffix(displayName),
+    };
+  });
+}
+
+function formatBaseDisplayName(stem: string, rawDisplay: string | undefined, hasEfforts: boolean): string {
+  const cleaned =
+    rawDisplay === undefined
+      ? stem
+      : (hasEfforts ? rawDisplay.replace(DISPLAY_EFFORT_SUFFIX, '') : rawDisplay).trim();
+  const base = cleaned.length > 0 ? cleaned : stem;
+  if (stem.includes('-tiered') && !/\btiered\b/i.test(base)) {
+    return `${base} Tiered`;
+  }
+  return base;
+}
+
+function stemMatchesDisplay(stem: string, display: string): boolean {
+  const normalize = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '');
+  return normalize(stem) === normalize(display);
+}
+
+function withAgySuffix(display: string): string {
+  if (/\bagy\b/i.test(display)) return display;
+  return `${display} (agy)`;
+}
+
+export async function refreshGeminiForwarderModels(
+  host: CloseRouterRefreshHost,
+  config: ManagedKimiConfigShape,
+  options: GeminiForwarderRefreshOptions = {},
+): Promise<GeminiForwarderRefreshResult> {
+  const env = options.env ?? process.env;
+  const failures = new FailureLog();
+  const targets = geminiForwarderTargets(config, options.providerId, env, failures);
+  if (targets.length === 0) {
+    return { config, changed: [], unchanged: [], failed: failures.list() };
+  }
+
+  const fetched = new Map<string, GeminiForwarderModelFamily[]>();
+  for (const target of targets) {
+    try {
+      const entries = await fetchCatalog(target.modelsUrl, target.apiKey, host.userAgent, options);
+      if (entries.length === 0) continue;
+      fetched.set(target.providerId, groupGeminiForwarderModels(entries));
+    } catch (error) {
+      failures.add(
+        target.providerId,
+        `Gemini forwarder model catalog request failed (${errorMessage(error)}); keeping the previous models.`,
+      );
+    }
+  }
+
+  if (fetched.size === 0) {
+    return { config, changed: [], unchanged: [], failed: failures.list() };
+  }
+
+  let fresh: ManagedKimiConfigShape;
+  try {
+    fresh = await host.getConfig();
+  } catch (error) {
+    for (const providerId of fetched.keys()) {
+      failures.add(
+        providerId,
+        `Could not re-read the config after the Gemini forwarder request: ${errorMessage(error)}`,
+      );
+    }
+    return { config, changed: [], unchanged: [], failed: failures.list() };
+  }
+
+  const next = structuredClone(fresh);
+  if (!isRecord(next.models)) next.models = {};
+  const subagentEffort = secondaryModelEffort(fresh);
+  const changed = new Map<string, GeminiForwarderProviderChange>();
+  const seen = new Set<string>();
+
+  for (const target of targets) {
+    const families = fetched.get(target.providerId);
+    if (families === undefined) continue;
+    const provider = fresh.providers[target.providerId];
+    if (!isRecord(provider) || provider['modelSource'] === 'static') continue;
+    seen.add(target.providerId);
+
+    const existingEntries = existingProviderAliases(fresh, target.providerId);
+    let added = 0;
+    let updatedAliases = 0;
+    let limitsChanged = false;
+    let effortsChanged = false;
+
+    for (const family of families) {
+      const matching = existingEntries.filter(
+        (entry) => family.memberIds.has(entry.modelId) || entry.modelId === family.stem,
+      );
+
+      if (matching.length > 0) {
+        const metadata: AliasMetadata = {
+          maxContextSize: family.maxContextSize,
+          maxOutputSize: family.maxOutputSize,
+          efforts: family.efforts.length > 0 ? family.efforts : undefined,
+        };
+        for (const match of matching) {
+          const current = readAlias(fresh, match.alias);
+          let patched = patchAlias(current, target.endpointType, metadata);
+          const conflict = subagentEffortConflict(subagentEffort, match.alias, current, patched);
+          if (conflict !== undefined) {
+            failures.add(target.providerId, conflict);
+            patched = patchAlias(current, target.endpointType, { ...metadata, efforts: undefined });
+          }
+          if (!sameAlias(current, patched)) {
+            next.models[match.alias] = patched as never;
+            updatedAliases += 1;
+            if (
+              current['maxContextSize'] !== patched['maxContextSize'] ||
+              current['maxOutputSize'] !== patched['maxOutputSize']
+            ) {
+              limitsChanged = true;
+            }
+            if (JSON.stringify(thinkingFields(current)) !== JSON.stringify(thinkingFields(patched))) {
+              effortsChanged = true;
+            }
+          }
+        }
+        continue;
+      }
+
+      const alias = `${target.providerId}/${family.stem}`;
+      if (alias in next.models) continue;
+      next.models[alias] = buildAlias(target.providerId, family) as never;
+      added += 1;
+    }
+
+    if (added > 0 || updatedAliases > 0) {
+      changed.set(target.providerId, {
+        providerId: target.providerId,
+        added,
+        aliases: updatedAliases,
+        limits: limitsChanged,
+        efforts: effortsChanged,
+      });
+    }
+  }
+
+  const failed = failures.list();
+  const unchanged = [...seen].filter(
+    (providerId) =>
+      !changed.has(providerId) && !failed.some((failure) => failure.provider === providerId),
+  );
+  if (changed.size === 0) return { config: fresh, changed: [], unchanged, failed };
+
+  try {
+    const written = await host.setConfig({ models: next.models } as ManagedKimiConfigShape);
+    return { config: written, changed: [...changed.values()], unchanged, failed };
+  } catch (error) {
+    for (const providerId of changed.keys()) {
+      failures.add(
+        providerId,
+        `Could not save the refreshed Gemini forwarder models: ${errorMessage(error)}`,
+      );
+    }
+    return { config: fresh, changed: [], unchanged, failed: failures.list() };
+  }
+}
+
+function geminiForwarderTargets(
+  config: ManagedKimiConfigShape,
+  providerIdFilter: string | undefined,
+  env: Readonly<Record<string, string | undefined>>,
+  failures: FailureLog,
+): GeminiForwarderProviderTarget[] {
+  const targets: GeminiForwarderProviderTarget[] = [];
+  for (const [providerId, provider] of Object.entries(config.providers)) {
+    if (providerId.startsWith(ENV_OVERLAY_PREFIX)) continue;
+    if (providerIdFilter !== undefined && providerId !== providerIdFilter) continue;
+    if (!isRecord(provider)) continue;
+    if (provider['modelSource'] === 'static') continue;
+    if (provider['source'] !== undefined || provider['oauth'] !== undefined) continue;
+    if (!isGeminiForwarderProvider(providerId, provider)) continue;
+    const protocol = nonEmptyString(provider['type']) ?? 'openai_responses';
+    const endpointType = ENDPOINT_TYPE_BY_PROTOCOL[protocol];
+    if (endpointType === undefined || endpointType === 'messages') continue;
+    const modelsUrl = geminiForwarderModelsUrl(provider['baseUrl']);
+    if (modelsUrl === undefined) continue;
+    const declared = declaredProviderCredential(provider, providerId);
+    if (declared.kind === 'conflict') {
+      failures.add(providerId, declared.message);
+      continue;
+    }
+    let apiKey: string | undefined;
+    if (declared.kind === 'inline') {
+      apiKey = declared.apiKey;
+    } else if (declared.kind === 'env') {
+      apiKey = nonEmptyString(env[declared.apiKeyEnv]);
+    }
+    if (apiKey === undefined) continue;
+    targets.push({ providerId, modelsUrl, apiKey, endpointType });
+  }
+  return targets;
+}
+
+function existingProviderAliases(
+  config: ManagedKimiConfigShape,
+  providerId: string,
+): Array<{ readonly alias: string; readonly modelId: string }> {
+  const list: Array<{ readonly alias: string; readonly modelId: string }> = [];
+  for (const [alias, model] of Object.entries(config.models ?? {})) {
+    if (!isRecord(model) || alias.startsWith(ENV_OVERLAY_PREFIX)) continue;
+    if (nonEmptyString(model['provider']) !== providerId) continue;
+    if (model['oauth'] !== undefined) continue;
+    const modelId = nonEmptyString(model['name']) ?? nonEmptyString(model['model']);
+    if (modelId === undefined) continue;
+    list.push({ alias, modelId });
+  }
+  return list;
+}
+
+function buildAlias(
+  providerId: string,
+  family: GeminiForwarderModelFamily,
+): Record<string, unknown> {
+  const alias: Record<string, unknown> = {
+    provider: providerId,
+    model: family.canonicalModelId,
+    displayName: family.displayName,
+  };
+  if (family.maxContextSize !== undefined) alias['maxContextSize'] = family.maxContextSize;
+  if (family.maxOutputSize !== undefined) alias['maxOutputSize'] = family.maxOutputSize;
+  if (family.efforts.length > 0) {
+    alias['capabilities'] = ['tool_use', 'image_in', 'thinking', 'always_thinking'];
+    alias['supportEfforts'] = [...family.efforts];
+    alias['defaultEffort'] = family.efforts.includes('high')
+      ? 'high'
+      : family.efforts[Math.floor(family.efforts.length / 2)];
+  } else {
+    alias['capabilities'] = ['tool_use', 'image_in'];
+  }
+  return alias;
+}
+
+function subagentEffortConflict(
+  subagent: SubagentEffort | undefined,
+  alias: string,
+  current: Record<string, unknown>,
+  patched: Record<string, unknown>,
+): string | undefined {
+  if (subagent === undefined || !subagent.aliases.has(alias)) return undefined;
+  if (JSON.stringify(thinkingFields(current)) === JSON.stringify(thinkingFields(patched))) {
+    return undefined;
+  }
+  const problem = subagentEffortProblem(subagent.effort, patched);
+  if (problem === undefined) return undefined;
+  return `[secondary_model] default_effort "${subagent.effort}" would no longer work with ${alias}: ${problem}. Change default_effort to apply Gemini forwarder's efforts; keeping its previous efforts.`;
+}
+
+async function fetchCatalog(
+  modelsUrl: string,
+  apiKey: string,
+  userAgent: string | undefined,
+  options: GeminiForwarderRefreshOptions,
+): Promise<readonly unknown[]> {
+  if (CONTROL_CHARS.test(apiKey)) {
+    throw new Error('the API key contains control characters (such as a line break)');
+  }
+  const headers: Record<string, string> = {
+    Accept: 'application/json',
+    Authorization: `Bearer ${apiKey}`,
+  };
+  if (userAgent !== undefined) headers['User-Agent'] = userAgent;
+  const fetchImpl = options.fetchImpl ?? fetch;
+  const responseTimeout = new AbortController();
+  const timer = setTimeout(() => {
+    responseTimeout.abort(new DOMException('The catalog request timed out.', 'TimeoutError'));
+  }, options.requestTimeoutMs ?? DEFAULT_REQUEST_TIMEOUT_MS);
+  let response: Response;
+  try {
+    response = await fetchImpl(modelsUrl, {
+      headers,
+      redirect: 'error',
+      signal: AbortSignal.any([
+        AbortSignal.timeout(options.deadlineMs ?? DEFAULT_DEADLINE_MS),
+        responseTimeout.signal,
+      ]),
+    });
+  } catch (error) {
+    // oxlint-disable-next-line preserve-caught-error -- the cause can carry the API key; its text is kept, redacted
+    throw new Error(withoutKey(errorMessage(error), apiKey));
+  } finally {
+    clearTimeout(timer);
+  }
+  if (!response.ok) {
+    throw new Error(withoutKey(await readApiErrorMessage(response, `HTTP ${response.status}`), apiKey));
+  }
+  let text: string;
+  try {
+    text = await response.text();
+  } catch (error) {
+    // oxlint-disable-next-line preserve-caught-error -- the cause can carry the API key; its text is kept, redacted
+    throw new Error(withoutKey(errorMessage(error), apiKey));
+  }
+  let body: unknown;
+  try {
+    body = JSON.parse(text) as unknown;
+  } catch {
+    throw new Error('the response is not valid JSON');
+  }
+  const entries = isRecord(body) && Array.isArray(body['data']) ? body['data'] : undefined;
+  if (entries === undefined) throw new Error('the response has no data list');
+  return entries;
+}
+
+function withoutKey(message: string, apiKey: string): string {
+  return message.split(apiKey).join('[redacted]');
+}
